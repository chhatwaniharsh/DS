import pandas as pd
import matplotlib.pyplot as plt

# Read mtcars dataset directly from GitHub
mtcars = pd.read_csv(
    "https://raw.githubusercontent.com/selva86/datasets/master/mtcars.csv"
)

# Display first 5 rows
print(mtcars.head())

# Create boxplot
plt.figure(figsize=(8, 6))

plt.boxplot(
    [mtcars["mpg"], mtcars["cyl"]],
    tick_labels=["mpg", "cyl"]
)

plt.xlabel("Columns")
plt.ylabel("Values")
plt.title("Boxplot of mpg and cyl")

plt.savefig("mtcars_boxplot.png", dpi=300)

plt.show()
